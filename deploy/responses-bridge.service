[Unit]
Description=Responses-to-Chat API bridge
Documentation=https://github.com/example/workbuddy2api-stack
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=workbuddy
WorkingDirectory=/opt/responses-bridge
# Optional search API keys file (KEY=value per line)
EnvironmentFile=-/opt/responses-bridge/search.env
ExecStart=/usr/bin/python3 /opt/responses-bridge/responses-bridge.py --host 127.0.0.1 --port 7866 --upstream http://127.0.0.1:7863/v1/chat/completions --logdir /var/log/responses-bridge
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=responses-bridge

[Install]
WantedBy=multi-user.target
